# Local, production-shaped Docker Compose settings. Copy to .env.compose.
# Use URL-safe random values for secrets; never commit the copied file.
POSTGRES_DB=phishguard
POSTGRES_USER=phishguard
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
PHISHGUARD_PORT=8000

# This stack binds only to localhost and serves plain HTTP for local testing.
# An internet deployment must terminate TLS and enable Django's HTTPS settings.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
