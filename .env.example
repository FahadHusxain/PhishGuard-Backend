# Local development defaults. Never put production secrets in this file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-unique-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOW_ALL_ORIGINS=true
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_SESSION_SECONDS=28800
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO
PHISHGUARD_GEOLOCATION_ENABLED=false
PHISHGUARD_GEOLOCATION_TIMEOUT_SECONDS=2
PHISHGUARD_SCAN_RETENTION_DAYS=30
PHISHGUARD_ANON_RATE=60/min
PHISHGUARD_USER_RATE=300/min
PHISHGUARD_ANALYSIS_RATE=30/min
PHISHGUARD_ADMIN_RATE=10/min
PHISHGUARD_READ_RATE=120/min
PHISHGUARD_STATS_CACHE_SECONDS=10
PHISHGUARD_MAX_REQUEST_BYTES=16384
PHISHGUARD_MAX_REQUEST_FIELDS=20
PHISHGUARD_NUM_PROXIES=0
PHISHGUARD_ML_SHADOW_ENABLED=false
PHISHGUARD_PHISHING_THRESHOLD=50

# Required in hosted environments. SQLite is used only in development mode.
# DATABASE_URL=postgresql://user:password@host:5432/database
# CACHE_URL=redis://localhost:6379/1
