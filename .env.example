# Local development defaults. Never put production secrets in this file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-unique-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOW_ALL_ORIGINS=true
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
PHISHGUARD_GEOLOCATION_ENABLED=false
PHISHGUARD_GEOLOCATION_TIMEOUT_SECONDS=2
PHISHGUARD_ANON_RATE=60/min
PHISHGUARD_USER_RATE=300/min
PHISHGUARD_ML_ENABLED=false
PHISHGUARD_ML_WEIGHT=0.6
PHISHGUARD_PHISHING_THRESHOLD=50

# Set this in hosted environments. SQLite is used when it is absent.
# DATABASE_URL=postgresql://user:password@host:5432/database
